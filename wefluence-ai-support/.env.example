# Salin ke .env di VPS (jangan di-commit): cp .env.example .env
#
# ATURAN FORMAT DOCKER env_file (gampang bikin celaka):
# - JANGAN pakai kutip di sekitar value. Docker menganggapnya karakter literal,
#   jadi kuncinya jadi salah tanpa pesan error apa pun.
# - FIREBASE_SERVICE_ACCOUNT harus SATU baris (JSON minified).
# - \n di private_key dibiarkan sebagai literal \n, bukan baris baru asli.

# ---------------------------------------------------------------------------
# WAJIB
# ---------------------------------------------------------------------------
GROQ_API_KEY=isi_kunci_groq
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"..."}

# ---------------------------------------------------------------------------
# CADANGAN (sangat disarankan diisi)
# ---------------------------------------------------------------------------
# Dipakai kalau Groq mati atau kena batas. Kunci yang sama dengan yang dipakai
# fitur moderasi AI di Cloud Functions boleh dipakai ulang di sini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# MODEL
# ---------------------------------------------------------------------------
# BIASANYA TIDAK PERLU DIISI SAMA SEKALI.
#
# Nama model di Groq punya masa hidup. `llama-3.3-70b-versatile` yang dulu
# dipatok di sini akhirnya dihapus Groq, dan sejak itu tiap permintaan dijawab
# HTTP 404 selama berbulan-bulan tanpa ada yang tahu. Sekarang service ini
# menanyakan langsung ke Groq model apa saja yang hidup, lalu memakai yang
# pertama cocok dari urutan pilihan di api/config.py. Nama yang sudah
# dipensiunkan dilewati sendiri, dan kejadiannya dicatat sebagai
# `llm.models_retired` di log.
#
# Isi GROQ_MODELS cuma kalau mau mengubah urutan pilihannya. Yang paling depan
# yang dipakai duluan.
# GROQ_MODELS=openai/gpt-oss-120b,moonshotai/kimi-k2-instruct,llama-3.1-8b-instant
#
# Lihat urutan yang BENAR-BENAR dipakai hari ini (plus daftar model hidup):
#   docker compose exec ai-support curl -s "http://127.0.0.1:8000/api/health?probe=1"

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=500
LLM_TIMEOUT=25
LLM_MAX_RETRIES=2
MAX_TOOL_ROUNDS=3

# ---------------------------------------------------------------------------
# KEAMANAN
# ---------------------------------------------------------------------------
# 0 = klien lama (tanpa Firebase ID token) masih dilayani, tapi balasannya tidak
#     dikembalikan lewat HTTP, cuma ditulis ke Firestore.
# 1 = wajib Authorization: Bearer <ID token>. SETEL 1 setelah patch klien web
#     DAN mobile sudah tayang. Lihat api/auth.py.
REQUIRE_AUTH=0

# Lapis kedua opsional. Kalau diisi, permintaan wajib membawa header
# X-Internal-Key dengan nilai yang sama. Nginx sudah memeriksa X-API-Key, jadi
# ini cuma perlu kalau kontainer bisa dijangkau tanpa lewat nginx.
INTERNAL_API_KEY=

# ---------------------------------------------------------------------------
# BASIS PENGETAHUAN
# ---------------------------------------------------------------------------
# 1 = ikut sertakan fakta untuk fitur yang kodenya sudah ada tapi BELUM
#     di-deploy (kampanye per video, blokir klaim 3x, pindai semua, kampanye
#     privat, tanya jawab kampanye). Biarkan 0 sampai fiturnya benar-benar
#     tayang, supaya AI tidak menjelaskan tombol yang belum ada di layar orang.
KB_INCLUDE_UNRELEASED=0

# ---------------------------------------------------------------------------
# BATAS DAN CACHE
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=120
CONTEXT_CACHE_TTL=45
HISTORY_TURNS=8
ADMIN_HANDOVER_HOURS=12

LOG_LEVEL=INFO
